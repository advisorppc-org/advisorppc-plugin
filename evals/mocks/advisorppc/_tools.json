  "tools": [
    {
      "name": "advisor_read",
      "description": "(read-only) Run one read-only AdvisorPPC operation by name. Use after advisor_search_tools / advisor_tool_help. This runner accepts only operations on the read-only allowlist; it reads accounts, reports and settings and never changes anything.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "tool": {
            "type": "string"
          },
          "arguments": {
            "anyOf": [
              {
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          }
        },
        "required": [
          "tool"
        ]
      },
      "annotations": {
        "readOnlyHint": true
      }
    },
    {
      "name": "advisor_search_tools",
      "description": "(read-only) Find an AdvisorPPC operation by keyword. Use this when the operation you need is not in the tool list, then advisor_tool_help(name) for its parameters, then advisor_read or advisor_write to run it.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string"
          },
          "limit": {
            "type": "integer",
            "default": 15
          }
        },
        "required": [
          "query"
        ]
      },
      "annotations": {
        "readOnlyHint": true
      }
    },
